f=audio@samp.rate,
wl=96, # longer window lengths = better frequency resolution / shorte wl = better time resolutionm smaller value makes it easier to see, better resoluti, trued larger nunebrs but plot data is veryh small, 128 seems ball park best
flim=c(6,10), # logner frequsny range also to above, as so otuliers visible higer frequencies
tlim=c(0,70), # time range is a lot longer than rpevious
noisereduction=2) # don't see a mssive difference between noisereduction as = 1 or = 2...
}
# just to see what the options are before modifyign thre code
audio_wav_df_rec_voc$vocalization_type
flight_df <- audio_wav_df_rec_voc %>% filter(vocalization_type == "flight call")
nrow(flight_df)
for (flight_bird in flight_df$file_name) {
wav_path_1 <- file.path(datalocation, flight_bird)
audio <- readWave(wav_path_1)
spectro(audio,
f=audio@samp.rate,
wl=512, # longer window lengths = better frequency resolution / shorte wl = better time resolutionm smaller value makes it easier to see, better resoluti, trued larger nunebrs but plot data is veryh small, 128 seems ball park best
flim=c(0,10), # logner frequsny range also to above, as so otuliers visible higer frequencies
tlim=c(0,.9), # time range is a lot longer than rpevious
noisereduction=1) # don't see a mssive difference between noisereduction as = 1 or = 2...
}
# we'll calculate some metrics and put them into a new dataframe which we can then plot
key_metrics_df <- audio_wav_df_rec_voc %>% filter(!is.na(vocalization_type)) %>%
# crate the column to store the calculated data
mutate(avg_amp = (max_amp_left + min_amp_left) / 2) %>%
group_by(vocalization_type) %>%
summarise(
mean_duration = mean(duration_seconds),
mean_max_amp = mean(max_amp_left),
mean_min_amp = mean(min_amp_left),
mean_avg_amp = mean(avg_amp),
n = n()
)
# display the data
data.frame(key_metrics_df)
#some basic bar chart plots of summary metrics
ggplot(key_metrics_df, aes(x = vocalization_type, y = mean_max_amp)) + geom_col(fill = "steelblue") +
labs(
title = "Mean Max Amplitude by Vocalization Type",
x = "Call Type",
y = "Mean Max Amplitude"
) +
theme_minimal(base_size = 14)
ggplot(key_metrics_df, aes(x = vocalization_type, y = mean_min_amp)) + geom_col(fill = "steelblue") +
labs(
title = "Mean Min Amplitude by Vocalization Type",
x = "Call Type",
y = "Mean  Min Amplitude"
) +
theme_minimal(base_size = 14)
ggplot(key_metrics_df, aes(x = vocalization_type, y = mean_avg_amp)) + geom_col(fill = "steelblue") +
labs(
title = "Mean Average Amplitude by Vocalization Type",
x = "Call Type",
y = "Mean Average Amplitude"
) +
theme_minimal(base_size = 14)
ggplot(key_metrics_df, aes(x = vocalization_type, y = mean_duration)) + geom_col(fill = "steelblue") +
labs(
title = "Mean Duration by Vocalization Type",
x = "Call Type",
y = "Mean Average Amplitude"
) +
theme_minimal(base_size = 14)
