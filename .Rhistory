#| label: 2-del-outliers-cond
#| fig.cap: "Summary of Waterbodies with Extreme Conductivity Values (> 2000 µS/cm)"
# --- Identify and summarise extreme conductivity values (> 2000 µS/cm) ---
extreme_cond <- wqi_dsubset_clean %>%
filter(conductivity > 2000) %>%
group_by(waterbodyname) %>%
summarise(
n_extreme = n(),
max_cond  = max(conductivity, na.rm = TRUE),
.groups = "drop"
) %>%
arrange(desc(n_extreme))
knitr::kable(extreme_cond, caption = "Summary of Waterbodies with Extreme Conductivity Readings (> 2000 µS/cm)")
#| label: desc-conductivity
#| fig.cap: "Table X: Descriptive Statistics for Conductivity Values"
# --- Descriptive statistics ---
# pastecs::stat.desc() gives detailed descriptive info
pastecs::stat.desc(wqi_dsubset_clean_t_bod$conductivity, basic = FALSE)
# psych::describe() gives mean, sd, median, skew, kurtosis, etc.
psych::describe(wqi_dsubset_clean_t_bod$conductivity)
# --- Skewness and Kurtosis (standardised) ---
# semTools::skew() and semTools::kurtosis() return [value, SE]
cond_skew <- semTools::skew(wqi_dsubset_clean_t_bod$conductivity)
cond_kurt <- semTools::kurtosis(wqi_dsubset_clean_t_bod$conductivity)
# Standardised (z) skewness and kurtosis
cond_skew_z <- cond_skew[1] / cond_skew[2]
cond_kurt_z <- cond_kurt[1] / cond_kurt[2]
cat("Standardised skewness (z):", round(cond_skew_z, 2), "\n")
cat("Standardised kurtosis (z):", round(cond_kurt_z, 2), "\n")
# --- Percent of cases outside typical z-score thresholds ---
# Absolute z-scores for Conductivity
zcond <- abs(scale(wqi_dsubset_clean_t_bod$conductivity))
# % beyond ±1.96 (approx 5% expected in normal data)
FSA::perc(as.numeric(zcond), 1.96, "gt")
# % beyond ±3.29 (approx 0.1% expected in normal data)
FSA::perc(as.numeric(zcond), 3.29, "gt")
